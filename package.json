{
  "name": "pauta-publica",
  "private": true,
  "scripts": {
    "prepare": "husky",
    "commitlint": "commitlint",
    "release": "semantic-release",
    "release:dry": "semantic-release --dry-run",
    "dev:frontend": "pnpm --filter ./frontend dev",
    "build:frontend": "pnpm --filter ./frontend build",
    "test:frontend": "pnpm --filter ./frontend test",
    "open": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/open-workspaces.ps1",
    "dev": "docker compose up -d",
    "dev:logs": "docker compose logs -f",
    "dev:stop": "docker compose stop",
    "sync:frontend": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/sync-frontend.ps1",
    "sync:backend": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/sync-backend.ps1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.11",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "prettier": "^3.10.1",
    "semantic-release": "^25.0.9"
  }
}
